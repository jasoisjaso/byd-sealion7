#!/bin/bash
# Mock adb for dry-running kit.sh without a car (used by tests/dry-run.sh).
# Knobs (env), all optional except MOCK_STATE:
#   MOCK_STATE=dir              where the fake car keeps its state (required)
#   MOCK_REFUSE=1               'adb connect' is refused
#   MOCK_AUTH_POLLS=N           'adb devices' says 'unauthorized' N times before 'device'
#   MOCK_STATE_WORD=connecting  word to show instead of 'unauthorized'
#   MOCK_OFFLINE_FIRST=1        connection is 'offline' until the script disconnects + reconnects
#   MOCK_FAIL_PKG=pkg           make that one install fail...
#   MOCK_FAIL_MSG=INSTALL_FAILED_...   ...with this message
#   MOCK_DROP_BEFORE_INSTALL=1  the car vanishes just as the install starts
#   MOCK_PRESEED="pkg=ver ..."  packages already on the car before the run
#   MOCK_CRLF=1                 'adb shell' output lines end in \r, like a real device
# Behaviour copied from the real car: a second 'connect' to an existing connection is a no-op.
set -u
STATE="${MOCK_STATE:?set MOCK_STATE}"
mkdir -p "$STATE"
printf 'adb %s\n' "$*" >> "$STATE/calls.log"
serial=""
if [[ "${1:-}" == "-s" ]]; then serial="$2"; shift 2; fi
cmd="${1:-}"; [[ $# -gt 0 ]] && shift
connected() { [[ -s "$STATE/connected" ]]; }
if [[ ! -e "$STATE/seeded" ]]; then
  touch "$STATE/seeded" "$STATE/installed"
  for kv in ${MOCK_PRESEED:-}; do echo "${kv%%=*} ${kv#*=}" >> "$STATE/installed"; done
fi
ver_of() { awk -v p="$1" '$1==p {print $2}' "$STATE/installed"; }

case "$cmd" in
  start-server|kill-server) exit 0 ;;
  version) echo "Android Debug Bridge version 1.0.41 (mock)"; exit 0 ;;
  connect)
    if [[ "${MOCK_REFUSE:-0}" == 1 ]]; then echo "cannot connect to $1: Connection refused"; exit 1; fi
    if connected; then echo "already connected to $1"; exit 0; fi
    echo "$1" > "$STATE/connected"
    if [[ ${MOCK_AUTH_POLLS:-0} -gt 0 && ! -s "$STATE/polls" ]]; then echo "failed to authenticate to $1"; exit 1; fi
    echo "connected to $1"; exit 0 ;;
  disconnect) rm -f "$STATE/connected"; touch "$STATE/reconnected"; echo "disconnected $1"; exit 0 ;;
  devices)
    echo "List of devices attached"
    if connected; then
      n=0; [[ -s "$STATE/polls" ]] && n=$(cat "$STATE/polls"); n=$((n+1)); echo "$n" > "$STATE/polls"
      if [[ "${MOCK_OFFLINE_FIRST:-0}" == 1 && ! -e "$STATE/reconnected" ]]; then printf '%s\toffline\n' "$(cat "$STATE/connected")"
      elif [[ $n -le ${MOCK_AUTH_POLLS:-0} ]]; then printf '%s\t%s\n' "$(cat "$STATE/connected")" "${MOCK_STATE_WORD:-unauthorized}"
      else printf '%s\tdevice\n' "$(cat "$STATE/connected")"; fi
    fi
    exit 0 ;;
  shell)
    connected || { echo "adb: device '$serial' not found" >&2; exit 1; }
    shell_cmd() {
      local all="$*"
      case "$all" in
        "getprop ro.build.version.release") echo "11" ;;
        "getprop ro.build.display.id") echo "DX_BYD_AUTO-user 11 RQ3A.211001.001 mock" ;;
        "pm list packages "*) awk -v p="${all##* }" 'index($1,p) {print "package:" $1}' "$STATE/installed" ;;
        "dumpsys package "*) v=$(ver_of "${all##* }"); [[ -n "$v" ]] && printf 'Packages:\n    versionCode=1 minSdk=26 targetSdk=34\n    versionName=%s\n' "$v"; return 0 ;;
        "rm -rf "*) echo "${all#rm -rf }" >> "$STATE/removed_dirs" ;;
        *) echo "mock: unhandled shell command: $all" >&2; return 1 ;;
      esac
    }
    if [[ "${MOCK_CRLF:-0}" == 1 ]]; then shell_cmd "$@" | sed $'s/$/\r/'; exit "${PIPESTATUS[0]}"; fi
    shell_cmd "$@"; exit $? ;;
  install)
    connected || { echo "adb: device '$serial' not found" >&2; exit 1; }
    if [[ "${MOCK_DROP_BEFORE_INSTALL:-0}" == 1 ]]; then rm -f "$STATE/connected"; echo "adb: device '$serial' not found" >&2; exit 1; fi
    file="${!#}"; base=$(basename "$file")
    case "$base" in
      SmartTube_*) pkg=org.smarttube.stable ;; *) pkg="unknown.$base" ;;
    esac
    ver=$(echo "$base" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    [[ -s "$file" ]] || { echo "adb: failed to stat $file: No such file or directory"; exit 1; }
    echo "Performing Streamed Install"
    if [[ "$pkg" == "${MOCK_FAIL_PKG:-}" ]]; then
      echo "adb: failed to install $file: Failure [${MOCK_FAIL_MSG:-INSTALL_FAILED_OLDER_SDK}]"; exit 1
    fi
    grep -v "^$pkg " "$STATE/installed" > "$STATE/installed.new"; mv "$STATE/installed.new" "$STATE/installed"
    echo "$pkg $ver" >> "$STATE/installed"; echo "$pkg" >> "$STATE/install_log"
    echo "Success"
    exit 0 ;;
  uninstall)
    connected || { echo "adb: device '$serial' not found" >&2; exit 1; }
    if grep -q "^$1 " "$STATE/installed"; then
      grep -v "^$1 " "$STATE/installed" > "$STATE/installed.new"; mv "$STATE/installed.new" "$STATE/installed"; echo "Success"
    else echo "Failure [DELETE_FAILED_INTERNAL_ERROR]"; exit 1; fi ;;
  *) echo "mock: unhandled: $cmd $*" >&2; exit 1 ;;
esac
